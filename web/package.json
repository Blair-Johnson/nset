{
  "name": "nset-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/{api,config,images,main,plot,settings,utils,views}*.ts\" src/style.css \"tests/*.ts\" *.ts *.json index.html"
  },
  "dependencies": {
    "openseadragon": "6.1.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
